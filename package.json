{
  "name": "claudia-local",
  "version": "0.3.0",
  "description": "Your own agent, running on your computer: chat with any model on your own keys, tasks, Telegram, skills, memory, a creator studio and Claudia (Solana first). Bring your own keys.",
  "license": "MIT",
  "author": "Claudia (useclaudia.xyz)",
  "homepage": "https://github.com/claudia-onchain/Claudia-Local#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudia-onchain/Claudia-Local.git"
  },
  "bugs": {
    "url": "https://github.com/claudia-onchain/Claudia-Local/issues"
  },
  "keywords": [
    "agent",
    "ai-agent",
    "local-first",
    "byok",
    "solana",
    "claudia",
    "mcp",
    "telegram",
    "self-hosted"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "claudia-local": "bin/claudia-local.js"
  },
  "files": [
    "bin/",
    "server/",
    "dashboard/dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p dashboard/tsconfig.json --noEmit && vite build --config dashboard/vite.config.ts",
    "start": "node server/index.js",
    "dev": "vite --config dashboard/vite.config.ts",
    "check": "node scripts/check.mjs",
    "app:mac": "bash native/build-app.sh",
    "prepack": "npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "@useclaudia/media": "^0.3.0",
    "@useclaudia/sdk": "^0.3.0",
    "@useclaudia/social": "^0.3.0",
    "bs58": "^6.0.0",
    "viem": "^2.57.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
